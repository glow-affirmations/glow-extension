{
  "name": "glow-affirmations",
  "displayName": "Glow Affirmations",
  "description": "Calm audio affirmations in your code editor.",
  "version": "0.1.5",
  "publisher": "justglow",
  "author": {
    "name": "Glow",
    "url": "https://justglow.dev"
  },
  "license": "GPL-3.0-or-later",
  "icon": "media/glow-marketplace-icon.png",
  "homepage": "https://justglow.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/glow-affirmations/glow-extension.git"
  },
  "bugs": {
    "url": "https://github.com/glow-affirmations/glow-extension/issues"
  },
  "keywords": [
    "affirmations",
    "audio",
    "focus",
    "mindfulness",
    "productivity",
    "wellbeing"
  ],
  "galleryBanner": {
    "color": "#0b0b0b",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:glow.sidebarView"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "glow",
          "title": "Glow",
          "icon": "media/glow-sidebar.svg"
        }
      ]
    },
    "views": {
      "glow": [
        {
          "id": "glow.sidebarView",
          "name": "Glow",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "glow.focusSidebar",
        "title": "Glow: Show Sidebar"
      },
      {
        "command": "glow.openDashboard",
        "title": "Glow: Open Dashboard"
      },
      {
        "command": "glow.openCommunity",
        "title": "Glow: Open Community"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun run clean && bun run check && bun run build:webview && bun run build:extension",
    "clean": "bun -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true })'",
    "build:extension": "bun build ./src/extension.ts --outdir=./dist --entry-naming=extension.cjs --target node --format cjs --external vscode --minify",
    "build:webview": "bun run --cwd ./webview build",
    "check": "bun run check:extension && bun run --cwd ./webview check",
    "check:extension": "tsc --noEmit --project tsconfig.json",
    "test": "bun test",
    "audit:public": "bun scripts/audit-public-tree.ts",
    "audit:brand": "bun scripts/verify-brand-context.ts",
    "audit:vsix": "bun scripts/audit-vsix.ts",
    "licenses": "bun scripts/generate-license-inventory.ts",
    "verify:release": "bun scripts/verify-release-version.ts",
    "watch:extension": "bun build ./src/extension.ts --outdir=./dist --entry-naming=extension.cjs --target node --format cjs --external vscode --sourcemap=linked --watch",
    "watch:webview": "bun run --cwd ./webview dev",
    "package": "bunx vsce package --no-dependencies --baseImagesUrl https://justglow.dev"
  },
  "workspaces": [
    "webview"
  ],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.6"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "undici": "7.29.0"
  },
  "packageManager": "bun@1.3.13"
}
